---
import FaqQuestion from '../../../components/FaqQuestion.astro';
import { getFaq } from '../../../lib/faq';

export function getStaticPaths() {
  return getFaq('en').flatMap(g => g.items).map(item => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<FaqQuestion lang="en" item={item} />
