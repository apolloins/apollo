---
// Apollo brand mark: a plain sun disc with a brush-style letter A in front of it
// (thin left stroke, heavy right stroke, crossbar sweeping up to the right).
// A gap (mask) separates the A from the sun so it reads on any background; the
// second mask path keeps the sun out of the space under the crossbar.
// Same geometry as public/favicon.svg.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg class={className} viewBox="0 0 100 100" aria-hidden="true">
  <defs>
    <mask id="apollo-logo-gap" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
      <rect width="100" height="100" fill="white" />
      <path d="M50 26.24 L89.41 97.65 L68.82 97.65 Q65.88 87.06 62.12 76.47 Q45.29 78.47 25.88 87.06 L20.94 97.65 L10 97.65 Z M48 40.59 Q52.94 54.12 60.24 70.82 Q45.88 72.12 28.82 80.59 Z" fill="black" fill-rule="evenodd" stroke="black" stroke-width="5.65" stroke-linejoin="round" />
      <path d="M25.88 87.06 Q45.29 78.47 62.12 76.47 Q65.88 87.06 68.82 97.65 L20.94 97.65 Z" fill="black" />
    </mask>
  </defs>
  <circle cx="50.00" cy="42.94" r="40.59" mask="url(#apollo-logo-gap)" class="fill-secondary" />
  <path d="M50 26.24 L89.41 97.65 L68.82 97.65 Q65.88 87.06 62.12 76.47 Q45.29 78.47 25.88 87.06 L20.94 97.65 L10 97.65 Z M48 40.59 Q52.94 54.12 60.24 70.82 Q45.88 72.12 28.82 80.59 Z" fill-rule="evenodd" class="fill-primary" />
</svg>
